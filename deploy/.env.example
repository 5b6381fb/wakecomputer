# Registry image used by `sh up.sh`. Example: ghcr.io/owner/wakecomputer:0.1.0
WC_IMAGE=

# Base URL embedded in the Agent install commands copied from the App.
# Enrollment is LAN-only, so this must be the LAN address, not the public hostname.
WC_PUBLIC_URL=http://192.168.1.3:8085

# Address the API binds to inside the container (host network).
WC_HTTP_ADDR=192.168.1.3:8085

# CIDRs allowed to supply X-Forwarded-For.
WC_TRUSTED_PROXIES=192.168.1.3/32,172.16.0.0/12

# Default Wake-on-LAN broadcast target for your LAN.
WC_WOL_DEFAULT_BROADCAST=192.168.1.255

WC_LOG_LEVEL=info
WC_LOG_FORMAT=json

# Leave empty to generate and print an initial password on first start.
WC_ADMIN_PASSWORD=
